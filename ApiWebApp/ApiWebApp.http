@ApiWebApp_HostAddress = http://localhost:5178

# Get all users
GET {{ApiWebApp_HostAddress}}/api/users
Accept: application/json
//Delete all Null Fields by include in repository method 11.09.2024
###

# Get user by ID
GET {{ApiWebApp_HostAddress}}/api/users/{id}
Accept: application/json

###

# Create a new user
POST {{ApiWebApp_HostAddress}}/api/users
Content-Type: application/json
Accept: application/json


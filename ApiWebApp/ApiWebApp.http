###

# Update user by ID
PUT {{ApiWebApp_HostAddress}}/api/users/39b98f38-84e3-4801-9013-2adb5b4dad6f
Content-Type: application/json
Accept: application/json

{
  "firstName": "UpdatedFirstName",
  "lastName": "UpdatedLastName",
  "phoneNumber": "0987654321",
  "role": "Admin"
}

###

# Delete user by ID
DELETE {{ApiWebApp_HostAddress}}/api/users/c7f2411a-8c46-4175-947b-52656e38cb0a


